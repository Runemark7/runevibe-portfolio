# Local development only. Production reads DATABASE_URL from the process
# environment or from the Kubernetes Secret named in the Helm values.
# Production requires sslmode=require. The application role must be a member
# of the shared apps group and must own its database, because migrations run
# at startup. Do not put a production host, address, or password in this file.
DATABASE_URL=postgres://portfolio:localdev@localhost:5432/portfolio?sslmode=disable
